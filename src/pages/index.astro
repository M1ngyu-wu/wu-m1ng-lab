---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon';
import RecentActivity from '../components/RecentActivity';
import { ArchiveRecent } from '../components/ArchiveBrowse';
import ArticleCard from '../components/ArticleCard.astro';
import { categories } from '../data/knowledge';
import { getArticles, dateLabel } from '../lib/articles';
import { url } from '../lib/url';
import '../styles/notebook.css';

const articles = await getArticles();
const modules = [
  ['book', 'CTF 题解中心', '浏览题解与历史版本', 'writeups/'],
  ['lab', 'Pwn 可视化实验室', '观察内存与寄存器', 'lab/'],
  ['network', '网络安全知识图谱', '查看知识点之间的联系', 'knowledge/'],
  ['command', '工具与命令速查库', '查找用法与笔记', 'tools/'],
  ['learning', '学习进度', '记录学习与自测', 'learning/'],
];
---

<Layout>
  <section class="page-width notebook-hero">
    <div class="notebook-title">
      <span class="eyebrow">CYBER SECURITY LAB</span>
      <h1>
        wu_m1ng<span class="accent">_</span>
      </h1>
      <p>记录漏洞分析、CTF 题解与网络安全技术探索。</p>
      <div class="hero-tags">
        {['PWN', 'WEB', 'CRYPTO', 'REVERSE', 'LINUX'].map((t) => (
          <span>{t}</span>
        ))}
      </div>
      <div class="hero-buttons">
        <a class="button primary" href={url('writeups/')}>
          浏览题解 <Icon name="right" size={16} />
        </a>
        <a class="button secondary" href={url('knowledge/')}>
          探索知识图谱 <Icon name="network" size={16} />
        </a>
      </div>
    </div>
    <aside class="notebook-index" aria-label="知识库工作区">
      <div class="index-heading">
        <Icon name="layers" /> 知识库工作区
      </div>
      {[
        ['writeups/import/', '导入题解', 'Markdown · TXT'],
        ['search/code/', '检索代码', '章节与代码片段'],
        ['growth/', '查看成长', '进度与复习记录'],
      ].map(([path, title, hint]) => (
        <a href={url(path)}>
          <span>
            {title}
            <small>{hint}</small>
          </span>
          <Icon name="arrow" size={18} />
        </a>
      ))}
    </aside>
  </section>
  <section class="page-width notebook-section">
    <h2>实验室入口</h2>
    <div class="notebook-modules">
      {modules.map(([icon, title, desc, path]) => (
        <a href={url(path)}>
          <Icon name={icon} size={22} />
          <strong>{title}</strong>
          <small>{desc}</small>
        </a>
      ))}
    </div>
  </section>
  <section class="page-width notebook-section">
    <div class="section-heading">
      <h2>最新题解</h2>
      <a class="text-link" href={url('writeups/')}>
        全部题解 →
      </a>
    </div>
    <ArchiveRecent limit={3} client:load />
    {articles
      .filter((a) => a.data.kind === 'Writeup')
      .slice(0, 3)
      .map((a) => (
        <a class="notebook-row" href={url('articles/' + a.id + '/')}>
          <time>{dateLabel(a.data.date)}</time>
          <strong>{a.data.title}</strong>
          <small>教学示例 ↗</small>
        </a>
      ))}
  </section>
  <section class="page-width notebook-section">
    <div class="section-heading">
      <h2>最新技术文章</h2>
      <a class="text-link" href={url('archives/')}>
        文章归档 →
      </a>
    </div>
    <div class="article-grid">
      {articles
        .filter((a) => a.data.kind !== 'Writeup')
        .slice(0, 3)
        .map((a, i) => (
          <ArticleCard article={a} index={i} />
        ))}
    </div>
  </section>
  <section class="page-width notebook-section">
    <div class="section-heading">
      <h2>知识体系</h2>
      <a class="text-link" href={url('knowledge/')}>
        查看图谱 →
      </a>
    </div>
    <div class="category-grid">
      {categories.map((c) => (
        <a href={url('categories/' + c.id + '/')} style={'--category-color:' + c.color}>
          <Icon name={c.icon} size={20} />
          <h3>{c.name}</h3>
        </a>
      ))}
    </div>
  </section>
  <section class="page-width notebook-section">
    <div class="section-heading">
      <h2>最近学习动态</h2>
      <a class="text-link" href={url('growth/')}>
        成长分析 →
      </a>
    </div>
    <RecentActivity client:load />
  </section>
</Layout>
